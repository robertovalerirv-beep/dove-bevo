<Window x:Class="DoveBevo.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Dove Bevo" Width="1100" Height="780" MinWidth="640" MinHeight="480"
        Background="#FFF4E4" Foreground="#1B1611" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFBF4" />
            <Setter Property="Foreground" Value="#1B1611" />
            <Setter Property="BorderBrush" Value="#E2D3BE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="BottomDestinationButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#FFFBF4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFBF4" BorderBrush="#E2D3BE" BorderThickness="0,0,0,1" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/Logo.png" Width="44" Height="44" Stretch="Uniform" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Dove Bevo" FontSize="19" FontWeight="Bold" />
                    <TextBlock Text="Prima di ordinare, sai quanto costa." FontSize="12" Foreground="#5E554B" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource NavButton}" Content="←" ToolTip="Indietro" Click="Back_Click" />
                    <Button x:Name="ForwardButton" Style="{StaticResource NavButton}" Content="→" ToolTip="Avanti" Click="Forward_Click" />
                    <Button x:Name="MoreButton" Style="{StaticResource NavButton}" Content="⋯" ToolTip="Altre opzioni" Click="More_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Ricarica" Click="Reload_Click" />
                                <MenuItem Header="Condividi" Click="Share_Click" />
                                <MenuItem Header="Privacy" Click="Privacy_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FFFBF4" BorderBrush="#E2D3BE" BorderThickness="0,1,0,0" Padding="10,4">
            <UniformGrid Columns="4" HorizontalAlignment="Stretch">
                <Button Style="{StaticResource BottomDestinationButton}" Content="Home" Click="Home_Click" />
                <Button Style="{StaticResource BottomDestinationButton}" Content="Mappa" Click="Map_Click" />
                <Button Style="{StaticResource BottomDestinationButton}" Content="Preferiti" Click="Favourites_Click" />
                <Button Style="{StaticResource BottomDestinationButton}" Content="Consigliati" Click="Recommendations_Click" />
            </UniformGrid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Website" Visibility="Hidden" />
            <Border x:Name="ErrorPanel" Background="#FFF4E4" Visibility="Collapsed" Padding="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="Non riesco a caricare Dove Bevo" FontSize="23" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ErrorText" Margin="0,12,0,18" Text="Controlla la connessione e riprova." TextWrapping="Wrap" />
                    <Button Style="{StaticResource NavButton}" Width="120" Content="Riprova" Click="Reload_Click" />
                </StackPanel>
            </Border>
            <Border x:Name="FavouritesPanel" Background="#FFF4E4" Visibility="Collapsed" Padding="24">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Preferiti" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Confronta i drink salvati su questo PC. Valuta e formato restano distinti; i prezzi richiedono internet." Margin="0,5,0,10" Foreground="#5E554B" TextWrapping="Wrap" />
                        <TextBlock Text="Filtra per drink" Foreground="#5E554B" />
                        <ComboBox x:Name="FavouriteDrink" MinWidth="210" MinHeight="44"
                                  HorizontalAlignment="Left" Margin="0,4,0,14"
                                  DisplayMemberPath="Label" AutomationProperties.Name="Filtra i drink preferiti"
                                  SelectionChanged="FavouriteDrink_SelectionChanged" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource NavButton}" Content="Apri sulla mappa" Click="OpenFavourite_Click" />
                        <Button Style="{StaticResource NavButton}" Content="Rimuovi" Click="RemoveFavourite_Click" />
                        <Button Style="{StaticResource NavButton}" Content="Torna alla mappa" Click="Map_Click" />
                    </StackPanel>
                    <ListBox x:Name="FavouriteList" FontSize="16" Background="#FFFBF4"
                             BorderBrush="#E2D3BE" DisplayMemberPath="Display"
                             MouseDoubleClick="OpenFavourite_Click" />
                </DockPanel>
            </Border>
            <Border x:Name="RecommendationsPanel" Background="#FFF4E4" Visibility="Collapsed" Padding="24">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Drink consigliati" FontSize="26" FontWeight="Bold" />
                        <TextBlock x:Name="RecommendationVenue" Margin="0,5,0,16" Foreground="#5E554B" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource NavButton}" Content="Ricarica" Click="Recommendations_Click" />
                        <Button Style="{StaticResource NavButton}" Content="Torna alla mappa" Click="Map_Click" />
                    </StackPanel>
                    <ListBox x:Name="RecommendationList" FontSize="16" Background="#FFFBF4"
                             BorderBrush="#E2D3BE" DisplayMemberPath="Display" MouseDoubleClick="OpenRecommendedVenue_Click" />
                </DockPanel>
            </Border>
            <Border x:Name="DiscoveryPanel" Background="#FFF4E4" Visibility="Collapsed" Padding="16"
                    SizeChanged="DiscoveryPanel_SizeChanged">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Scopri i prezzi" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="DiscoveryScopeNote"
                                   Text="Prezzi da menu: selezione, non elenco completo. Le segnalazioni dei clienti sono indicate."
                                   TextWrapping="Wrap" Margin="0,3,0,2" Foreground="#5E554B" />
                        <TextBlock Text="Valute e formati diversi non sono direttamente confrontabili; coperto e supplementi possono aggiungersi."
                                   TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#5E554B" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Zona" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button x:Name="DiscoveryCity" Style="{StaticResource NavButton}"
                                    Width="175" MinHeight="44" Content="Scegli città ⌄"
                                    Click="DiscoveryCity_Click" />
                            <Popup x:Name="DiscoveryCityPopup" PlacementTarget="{Binding ElementName=DiscoveryCity}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Width="320" MaxHeight="470" Padding="12" Background="#FFFBF4"
                                        BorderBrush="#E2D3BE" BorderThickness="1" CornerRadius="12">
                                    <DockPanel>
                                        <TextBox x:Name="DiscoveryCitySearch" DockPanel.Dock="Top"
                                                 Height="44" FontSize="16" Margin="0,0,0,8"
                                                 ToolTip="Cerca città" TextChanged="DiscoveryCitySearch_TextChanged"
                                                 PreviewKeyDown="DiscoveryCitySearch_PreviewKeyDown" />
                                        <Button x:Name="DiscoveryCityRetry" DockPanel.Dock="Bottom"
                                                Style="{StaticResource NavButton}" Content="Riprova elenco città"
                                                Click="DiscoveryCityRetry_Click" Visibility="Collapsed" />
                                        <TextBlock x:Name="DiscoveryCityMessage" DockPanel.Dock="Bottom"
                                                   TextWrapping="Wrap" Foreground="#5E554B"
                                                   Margin="0,7,0,0" />
                                        <ListBox x:Name="DiscoveryCityChoices" MinHeight="150" MaxHeight="345"
                                                 DisplayMemberPath="" Background="#FFFBF4"
                                                 BorderBrush="#E2D3BE"
                                                 SelectionChanged="DiscoveryCityChoices_SelectionChanged" />
                                    </DockPanel>
                                </Border>
                            </Popup>
                            <TextBlock Text="Cosa vuoi bere?" VerticalAlignment="Center" Margin="12,0,10,0" />
                            <ComboBox x:Name="DiscoveryDrink" Width="210" MinHeight="44"
                                      SelectionChanged="DiscoveryDrink_SelectionChanged" />
                            <Button Style="{StaticResource NavButton}" Content="Aggiorna" Margin="12,0,0,0" Click="ReloadDiscovery_Click" />
                        </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="FeaturedTitle" Text="Prezzi della zona" FontSize="17" FontWeight="Bold"
                                   Margin="0,3,0,2" Visibility="Collapsed" />
                        <TextBlock x:Name="FeaturedSubtitle" Text="Selezione di prezzi per il drink scelto"
                                   FontSize="12" Foreground="#5E554B" Margin="0,0,0,8" Visibility="Collapsed" />
                        <ScrollViewer x:Name="FeaturedScroller" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10"
                                      Visibility="Collapsed">
                            <ItemsControl x:Name="FeaturedCards">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" ToolTip="{Binding Row.Display}"
                                                Click="OpenFeaturedVenue_Click" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                Margin="0,0,10,0" HorizontalContentAlignment="Stretch">
                                            <Border Background="#FFFBF4" BorderBrush="#E2D3BE"
                                                    BorderThickness="1" CornerRadius="16" Padding="13"
                                                    Width="220" MinHeight="128">
                                                <StackPanel>
                                                    <TextBlock Text="●  DOVE BEVO" FontSize="10" FontWeight="Bold"
                                                               Foreground="#DD4B1B" />
                                                    <TextBlock Text="{Binding Drink}" FontSize="17" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                                                    <TextBlock Text="{Binding Venue}" FontSize="13" Foreground="#5E554B"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Price}" FontSize="20" FontWeight="Bold"
                                                               Foreground="#1B1611" Margin="0,7,0,0" />
                                                    <TextBlock Text="{Binding MinimumSpend}" FontSize="11" Foreground="#8A421B"
                                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="#5E554B"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource NavButton}" Content="Apri locale" Click="OpenDiscoveryVenue_Click" />
                        <Button Style="{StaticResource NavButton}" Content="Torna alla mappa" Click="Map_Click" />
                    </StackPanel>
                    <ListBox x:Name="DiscoveryList" FontSize="15" Background="#FFFBF4"
                             BorderBrush="#E2D3BE" DisplayMemberPath="Display"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             MouseDoubleClick="OpenDiscoveryVenue_Click">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF4E4" Padding="8,5" Margin="0,5,0,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Prezzi in " FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#FFFBF4" BorderBrush="#E2D3BE" BorderThickness="0,1,0,0" Padding="16,5">
            <TextBlock x:Name="StatusText" Text="Caricamento…" FontSize="12" Foreground="#5E554B" />
        </Border>
    </Grid>
</Window>
