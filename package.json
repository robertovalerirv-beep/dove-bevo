{
  "name": "dove-bevo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-tokens.mjs && vite build",
    "preview": "wrangler dev -c dist/dovebevo/wrangler.json --persist-to .wrangler/state --local-protocol https --show-interactive-dev-session=false",
    "lint": "eslint .",
    "typecheck": "wrangler types --check --strict-vars=false && tsc -b",
    "types": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=webkit --project=chromium-writes --project=webkit-writes",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:security": "vitest run --project worker && playwright test --project=security",
    "fixture": "node -e \"require('fs').cpSync('tests/fixtures/data','public/data/fixture',{recursive:true})\"",
    "db:local": "wrangler d1 migrations apply DB --local && wrangler d1 execute DB --local --file tests/fixtures/seed.sql",
    "verify": "node scripts/verify.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@preact/preset-vite": "2.10.6",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "hono": "4.13.13",
    "maplibre-gl": "6.14.0",
    "preact": "11.0.1",
    "zod": "4.6.6"
  },
  "allowScripts": {
    "esbuild": false,
    "workerd": false
  }
}
