{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dovebevo",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Assets never run the Worker; only /api/* does (SPEC 4).
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API, and the pages the Worker enriches for search engines (src/worker/routes/seo.ts, ADR 0025);
    // every other asset (JS, CSS, fonts, data) is served without running the Worker. The city slugs
    // are SEO_CITIES (tests/unit/seo-config.test.ts keeps the two lists equal).
    "run_worker_first": [
      "/api/*",
      "/",
      "/copertura",
      "/bar/*",
      "/robots.txt",
      "/llms.txt",
      "/sitemap.xml",
      "/milano",
      "/roma",
      "/torino",
      "/bologna",
      "/firenze",
      "/napoli",
    ],
  },
  // Invocation logs off: we log only what we write ourselves (SPEC 13.8).
  // Nightly cleanup of counters and dedup (SPEC 8), 02:30 UTC.
  "triggers": { "crons": ["0 * * * *"] },
  // 10 % sampling is enough to debug; query strings (geohash cells) never reach the logs.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
  },
  // Local and e2e use the fixture data; the deploy job sets the OSM import date (SPEC 5.3).
  // Local and e2e only (environments do not inherit vars): Cloudflare's public Turnstile test keys,
  // which always pass, and placeholder HMAC keys. Staging and production use real secrets.
  "vars": {
    "DATA_VERSION": "fixture",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_HOSTNAME": "example.com",
    "TURNSTILE_SECRET": "1x0000000000000000000000000000000AA",
    "SESSION_HMAC_KEY": "local-dev-only-session-key",
    "HASH_KEY": "local-dev-only-hash-key",
    // Cloudflare Access (D-19): empty = /api/admin/* always answers 403.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
  },
  // Local D1 only: the id is a placeholder; staging and production have their own databases.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dovebevo-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Burst limit keyed by the HMAC of the IP (SPEC 13.3); free-plan availability: ADR 0010.
  // Local and e2e share one IP across parallel tests: effectively off there, like the read limiter
  // (ADR 0027). The real 20 / 10 s is in staging and production below, and in the worker tests
  // (vitest.config.ts).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3000, "period": 10 } },
    // Cell reads. Local and e2e share one IP across parallel tests: effectively off there.
    { "name": "READ_LIMITER", "namespace_id": "1003", "simple": { "limit": 3000, "period": 60 } },
  ],
  // Bindings and vars are not inherited by environments: repeat them here.
  "env": {
    "staging": {
      "name": "dovebevo-staging",
      "triggers": { "crons": ["0 * * * *"] },
      "vars": {
        "DATA_VERSION": "none",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFUazHbuU79qVX5f",
        // Public site: www.dovebevo.com is served by this Worker; the siteverify hostname must match it.
        "TURNSTILE_HOSTNAME": "www.dovebevo.com",
        // Cloudflare Access application "dovebevo-staging" (/admin, /api/admin/*): public identifiers.
        "ACCESS_TEAM_DOMAIN": "broad-sunset-c81e.cloudflareaccess.com",
        "ACCESS_AUD": "f5e9f3e8eaeacbf04b818344e936e612f70c2b46b73ca9be08fdab7a45d944ef", // gitleaks:allow (public audience id, not a secret)
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dovebevo-staging",
          "database_id": "d2d4f6d4-b2fb-435b-9f9e-a2961d9c9839",
          "migrations_dir": "migrations",
        },
      ],
      // Async tasks: the queue already exists on Cloudflare; this Worker is producer and consumer.
      "queues": {
        "producers": [{ "binding": "TASKS_QUEUE", "queue": "dovebevo-tasks" }],
        "consumers": [{ "queue": "dovebevo-tasks", "max_batch_size": 10, "max_batch_timeout": 5 }],
      },
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 10 } },
        {
          "name": "READ_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
    },
  },
}
